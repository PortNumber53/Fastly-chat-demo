# Fastly Chat Demo Configuration

# Server settings
PORT=8080
HOST=0.0.0.0

# Fastly Fanout / GRIP settings
# Set these to enable Fastly-powered real-time delivery
FASTLY_FANOUT_ENABLED=false
FASTLY_GRIP_URL=http://api.fanout.io/realm/YOUR_REALM?gs=YOUR_TOKEN
FASTLY_GRIP_KEY=base64:YOUR_KEY
FASTLY_FANOUT_DOMAIN=

# Chat settings
MAX_ROOMS=100
MAX_MESSAGES_PER_ROOM=500
MAX_USERNAME_LENGTH=32
MAX_MESSAGE_LENGTH=2000
